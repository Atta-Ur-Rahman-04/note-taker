<% layout("/layouts/boilerplate") %>

<div class="row mt-2">
  <div class="col-10 offset-1">
    <a href="/notes/<%= note._id %>" class="back-link mb-2 d-inline-block"
      >&larr; Cancel</a
    >
    <h1 class="mb-4">Edit Your Note</h1>
    <form
      action="/notes/<%= note._id %>?_method=put"
      method="post"
      class="needs-validation"
      novalidate
    >
      <div class="row">
        <div class="mb-3 col-md-4">
          <label for="title" class="form-label">Title :</label>
          <input
            id="title"
            type="text"
            class="form-control"
            placeholder="Enter your title"
            name="Notes[title]"
            value="<%= note.title %>"
            required
          />
          <div class="invalid-feedback">Enter a valid title!</div>
        </div>
        <div class="mb-3 col-md-8">
          <label for="description" class="form-label">Description :</label>
          <input
            id="description"
            type="text"
            class="form-control"
            placeholder="Enter a short description"
            name="Notes[description]"
            value="<%= note.description %>"
            required
          />
          <div class="invalid-feedback">Enter a valid description!</div>
        </div>
      </div>

      <div class="mb-3">
        <label for="content" class="form-label">Your Note :</label>
        <textarea
          id="content"
          name="Notes[content]"
          cols="40"
          rows="5"
          placeholder="Enter you content"
          class="form-control"
          required
        >
<%= note.content %></textarea
        >
        <div class="invalid-feedback">Enter a valid note details!</div>
      </div>
      <Button class="btn submit-btn mt-3">Update</Button>
    </form>
  </div>
</div>
