<% layout("./layouts/boilerplate") %>
<div class="main-div">
  <div class="left">
    <h1>Write it down before you forget it.</h1>
    <p>
      Create, organize, and revisit your notes in seconds. No clutter, no
      distractions — just your thoughts, exactly where you left them.
    </p>
    <a href="/signup" class="left-cta">Create your first note →</a>
  </div>

  <div class="right">
    <ul class="feature-list">
      <li class="feature-item">
        <h3>
          <span class="highlight">Capture</span> every idea the moment it hits
        </h3>
        <p>No sign-in delays, no loading screens — just open and write.</p>
      </li>
      <li class="feature-item">
        <h3><span class="highlight">Private</span> by design</h3>
        <p>
          Your notes are yours alone — never shared, never sold, never scanned.
        </p>
      </li>
      <li class="feature-item">
        <h3><span class="highlight">Find</span> anything in seconds</h3>
        <p>Skip the folder-digging. Search does the remembering for you.</p>
      </li>
      <li class="feature-item">
        <h3>
          <span class="highlight">Pick up</span> exactly where you left off
        </h3>
        <p>
          Every note follows you — phone, laptop, wherever you open it next.
        </p>
      </li>
    </ul>
    <a href="/signup" class="signup-btn">Get Started — It's Free</a>
  </div>
</div>
